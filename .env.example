# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL / TimescaleDB connection ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=church_analytics
PGUSER=church_analytics_app
PGPASSWORD=changeme

# Set to 'true' if connecting to a managed Postgres/Timescale instance
# that requires SSL (e.g. Timescale Cloud, RDS with enforced SSL).
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true

# Connection pool tuning
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000

# Log any query slower than this threshold (ms)
SLOW_QUERY_THRESHOLD_MS=500

# --- App server ---
PORT=3000